# Hub sur le cadre : aucun fichier .env nécessaire.
# Calendriers : Réglages → Mes agendas → choisir les fichiers .ics.
# Google API : Client ID public dans le même écran, sans Client Secret.
# Les fichiers ICS et les exports privés doivent rester hors Git / dist.
# Voir docs/CONFIGURATION.md.

# Serveur Node OPTIONNEL sur ordinateur (pas nécessaire sur le cadre).
PORT=4173
HOST=127.0.0.1
BASE_URL=http://localhost:4173

# Anciennes intégrations Node : paramètres facultatifs, indépendants des imports ICS.
TODOIST_API_TOKEN=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Seulement pour une écoute réseau locale, avec un code de 24+ caractères.
# Aucun port Internet à ouvrir.
HUB_ACCESS_TOKEN=
