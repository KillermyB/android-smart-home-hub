# Node 22.9+ / Windows, macOS, Linux. Copier en .env ; ne jamais publier ce fichier.
PORT=4173
HOST=127.0.0.1
BASE_URL=http://localhost:4173

# Todoist > Paramètres > Intégrations > Développeur > Jeton API
TODOIST_API_TOKEN=

# Application Microsoft Entra, comptes personnels ET professionnels.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common

# Application Web Google Cloud ; activer Google Calendar API.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Seulement pour un accès réseau : HOST=0.0.0.0, code aléatoire de 24+ caractères.
# Ne pas ouvrir ce service sur Internet. Utiliser uniquement un réseau de confiance.
HUB_ACCESS_TOKEN=
